(ns cljd2dart.repl
  "An interactive REPL on top of the transpiler.

  Dart has no eval, so the REPL drives a separate, long-lived Dart VM:

    1. A form is transpiled into the body of `_repl_eval` in session.dart.
    2. The VM hot reloads session.dart through the VM service protocol.
    3. A service extension in the VM calls `_repl_eval` and reports the result.

  The VM is never restarted between forms, so atoms, open files, and every
  other piece of live state persist. The VM shares this process's terminal, so
  program output reaches it directly."
  (:require ["dart:async" :as async]
            ["dart:convert" :as convert]
            ["dart:io" :as io]
            [cljd.reader :as reader]
            [cljd.string :as str]
            [cljd2dart.transpile :as t]))

(def ^:private banner
  "cljd2dart REPL - :help for commands, :quit to exit, Ctrl-C to interrupt")

(def ^:private repl-help
  (str "Commands:\n"
       "  :help         show this help\n"
       "  :quit         leave the REPL (also :q, :exit, or Ctrl-D)\n"
       "  :reset        restart the session and forget all definitions\n"
       "  :load <file>  evaluate every form in a file\n"
       "  :session      print the definitions in this session\n"
       "  :dart         print the Dart generated for the last form\n"
       "\n"
       "*1 *2 *3 hold recent values and *e the last exception.\n"
       "Dart libraries: (require '[\"dart:math\" :as math])\n"))

(defn- write [s]
  (.write io/stdout s))

(defn- writeln [s]
  (.writeln io/stdout s))

;; ---------------------------------------------------------------------------
;; The session VM
;; ---------------------------------------------------------------------------

(defn- rpc
  "Call a VM service method. Returns the decoded response, or nil once the VM
  has died."
  [vm method params]
  (if @(:dead vm)
    nil
    (let [id (str (swap! (:ids vm) inc))
          done (async/Completer.)]
      (swap! (:pending vm) assoc id done)
      (.add (:ws vm)
            (convert/jsonEncode {"jsonrpc" "2.0" "id" id
                                       "method" method "params" params}))
      (await (.-future done)))))

(defn- on-message [vm msg]
  (let [res (convert/jsonDecode msg)
        id (get res "id")
        done (when id (get @(:pending vm) id))]
    (when done
      (swap! (:pending vm) dissoc id)
      (.complete done res))))

(defn- on-exit [vm]
  (reset! (:dead vm) true)
  (let [pending @(:pending vm)]
    (reset! (:pending vm) {})
    (doseq [[_ done] pending]
      (.complete done nil))))

(defn- wait-for-file
  "Poll for the service address, which the VM writes once it has started."
  [file dead]
  (loop [tries 0]
    (cond
      (.existsSync file) (.readAsStringSync file)
      (or @dead (> tries 3000)) (throw (Exception. "the Dart VM did not start"))
      :else (do
              (await (async/Future.delayed (Duration. .milliseconds 10)))
              (recur (inc tries))))))

(defn- wait-for-isolate
  "Find the session isolate once its eval extension has been registered."
  [vm]
  (loop [tries 0]
    (when (> tries 3000)
      (throw (Exception. "the Dart VM did not become ready")))
    (let [isolates (get (get (await (rpc vm "getVM" {})) "result") "isolates")
          id (when (and isolates (.-isNotEmpty isolates))
               (get (.-first isolates) "id"))
          isolate (when id
                    (get (await (rpc vm "getIsolate" {"isolateId" id}))
                         "result"))
          rpcs (when isolate (get isolate "extensionRPCs"))]
      (if (and rpcs (.contains rpcs "ext.cljd.eval"))
        id
        (do
          (await (async/Future.delayed (Duration. .milliseconds 10)))
          (recur (inc tries)))))))

(defn- start-vm
  "Start a session VM in a new directory and connect to its service."
  [dir]
  (let [info (io/File. (str dir "/service-uri"))
        session (io/File. (str dir "/session.dart"))
        dead (atom false)]
    (when (.existsSync info) (.deleteSync info))
    (.writeAsStringSync session (t/repl-source (t/repl-state) "  return null;"))
    (.writeAsStringSync (io/File. (str dir "/host.dart")) t/repl-host-main)
    (let [proc (await (io/Process.start
                       "dart"
                       #dart ^String [(str dir "/host.dart") (.-path info)]
                       .mode io/ProcessStartMode.inheritStdio))
          _ (.then (.-exitCode proc) (fn [_] (reset! dead true)))
          uri (await (wait-for-file info dead))
          ws-uri (str (str/replace-first uri "http" "ws") "ws")
          ws (await (io/WebSocket.connect ws-uri))
          vm {:proc proc :ws ws :session session
              :ids (atom 0) :pending (atom {}) :dead dead}]
      (.listen ws (fn [msg] (on-message vm msg)))
      (.then (.-exitCode proc) (fn [_] (on-exit vm)))
      (assoc vm :isolate (await (wait-for-isolate vm))))))

(defn- stop-vm [vm]
  (.kill (:proc vm) io/ProcessSignal.sigkill)
  (await (.-exitCode (:proc vm)))
  (await (.close (:ws vm))))

(defn- reload-error
  "Reload the session. Returns nil on success, or a compile error message."
  [vm]
  (let [res (await (rpc vm "reloadSources"
                        {"isolateId" (:isolate vm) "force" true}))
        result (when res (get res "result"))]
    (cond
      (nil? res) nil
      (true? (get result "success")) nil
      :else (let [notices (get result "notices")]
              (if (and notices (.-isNotEmpty notices))
                (str (get (.-first notices) "message"))
                (str (or (get res "error") res)))))))

(defn- run-eval
  "Run the reloaded form. Returns the result map, or nil if the VM died."
  [vm]
  (let [res (await (rpc vm "ext.cljd.eval" {"isolateId" (:isolate vm)}))]
    (when res
      (or (get res "result")
          {"error" (str (get res "error"))}))))

;; ---------------------------------------------------------------------------
;; Evaluating forms
;; ---------------------------------------------------------------------------

(defn- clean-compile-error
  "Compiler messages name the temporary session file; keep what matters."
  [msg]
  (let [lines (vec (str/split (str/trim msg) #"\n"))
        first-line (first lines)
        i (.indexOf first-line "Error: ")]
    (if (neg? i) (str/join "\n" lines) (subs first-line (+ i 7)))))

(defn- definition? [form]
  (and (list? form)
       (seq form)
       (contains? #{"def" "defonce" "defn" "defn-" "declare" "ns" "require"}
                  (str (first form)))))

(defn- flatten-do
  "Like Clojure, treat each form of a top-level do as its own top-level form."
  [form]
  (if (and (list? form) (seq form) (= "do" (str (first form))))
    (mapcat flatten-do (rest form))
    [form]))

(declare restart)

(defn- eval-one
  "Evaluate a single form. session is {:vm :state :forms :last-dart}."
  [session form show?]
  (let [compiled (try
                   (t/repl-compile (:state session) form)
                   (catch Object e {:failed (str e)}))]
    (if (:failed compiled)
      (do (writeln (str "error: " (:failed compiled))) session)
      (let [vm (:vm session)
            _ (.writeAsStringSync (:session vm)
                                  (t/repl-source (:state compiled)
                                                 (:body compiled)))
            compile-error (await (reload-error vm))]
        (if compile-error
          (do (writeln (str "error: " (clean-compile-error compile-error)))
              session)
          (let [_ (reset! (:evaluating? session) true)
                result (await (run-eval vm))
                _ (reset! (:evaluating? session) false)
                session (assoc session
                               :state (:state compiled)
                               :last-dart (:body compiled))]
            (cond
              (nil? result)
              (await (restart session))

              (get result "error")
              (do (writeln (str "error: " (get result "error"))) session)

              :else
              (do
                (when show?
                  (writeln (or (:echo compiled) (get result "value"))))
                (if (definition? form)
                  (update session :forms conj form)
                  session)))))))))

(defn- eval-forms [session forms show?]
  (loop [session session
         forms (vec (mapcat flatten-do forms))]
    (if (empty? forms)
      session
      (recur (await (eval-one session (first forms) show?))
             (vec (rest forms))))))

(defn- fresh-session
  "Start over with a new VM, keeping the session's shared cells."
  [session]
  (await (stop-vm (:vm session)))
  (assoc session
         :vm (await (start-vm (:dir session)))
         :state (t/repl-state)
         :forms []))

(defn- restart
  "The VM died or was interrupted. Start a new one and re-run the definitions."
  [session]
  (writeln ";; session VM stopped; restarting and re-running definitions")
  (let [forms (:forms session)
        fresh (await (fresh-session session))]
    (await (eval-forms fresh forms false))))

;; ---------------------------------------------------------------------------
;; Reading input
;; ---------------------------------------------------------------------------

(defn- form-complete?
  "True when src has balanced delimiters and ends outside a string/comment."
  [src]
  (let [n (count src)]
    (loop [i 0 state :code depth 0]
      (if (>= i n)
        (and (not= state :string) (<= depth 0))
        (let [ch (subs src i (inc i))]
          (cond
            (= state :string)
            (cond
              (= ch "\\") (recur (+ i 2) :string depth)
              (= ch "\"") (recur (inc i) :code depth)
              :else (recur (inc i) :string depth))

            (= state :comment)
            (recur (inc i) (if (= ch "\n") :code :comment) depth)

            (= ch "\"") (recur (inc i) :string depth)
            (= ch ";") (recur (inc i) :comment depth)
            (= ch "\\") (recur (+ i 2) :code depth)
            (or (= ch "(") (= ch "[") (= ch "{"))
            (recur (inc i) :code (inc depth))
            (or (= ch ")") (= ch "]") (= ch "}"))
            (recur (inc i) :code (dec depth))
            :else (recur (inc i) :code depth)))))))

(defn- parse-forms
  "Read every top-level form in src."
  [src]
  (vec (await (.toList (reader/read-stream
                        (async/Stream.value (t/normalize-percent-args src)))))))

(defn- eval-text [session text]
  (let [forms (try
                (await (parse-forms text))
                (catch Object e
                  (writeln (str "read error: " e))
                  []))]
    (await (eval-forms session forms true))))

;; ---------------------------------------------------------------------------
;; Commands
;; ---------------------------------------------------------------------------

(defn- command-name [line]
  (first (str/split (str/trim line) #"\s+")))

(def ^:private commands
  #{":help" ":quit" ":q" ":exit" ":reset" ":load" ":session" ":dart"})

(defn- command? [line]
  (contains? commands (command-name line)))

(defn- load-file [session line]
  (let [path (str/trim (subs (str/trim line) (count ":load")))
        file (io/File. path)]
    (cond
      (str/blank? path)
      (do (writeln "usage: :load <file>") session)

      (not (.existsSync file))
      (do (writeln (str "error: no such file: " path)) session)

      :else
      (await (eval-text session (.readAsStringSync file))))))

(defn- run-command
  "Run a REPL command. Returns the new session, or nil to quit."
  [session line]
  (let [cmd (command-name line)]
    (cond
      (contains? #{":quit" ":q" ":exit"} cmd) nil
      (= cmd ":help") (do (write repl-help) session)
      (= cmd ":load") (await (load-file session line))
      (= cmd ":session")
      (do
        (doseq [form (:forms session)]
          (writeln (pr-str form)))
        session)
      (= cmd ":dart") (do (writeln (or (:last-dart session) ";; nothing yet"))
                          session)
      :else
      (let [fresh (await (fresh-session session))]
        (writeln ";; session reset")
        fresh))))

;; ---------------------------------------------------------------------------
;; Main loop
;; ---------------------------------------------------------------------------

(defn- prompt [session buffer interactive?]
  (when interactive?
    (write (if (str/blank? buffer)
             (str (:ns (:state session)) "=> ")
             "   ... "))
    (await (.flush io/stdout))))

(defn- repl-loop
  "Read and evaluate lines until end of input or :quit. Returns the last
  session, so that its VM can be stopped."
  [session lines interactive? input-buffer]
  (loop [session session]
    (await (prompt session @input-buffer interactive?))
    (if-not (await (.moveNext lines))
      session
      (let [line (.-current lines)
            buffer @input-buffer]
        (cond
          (and (str/blank? buffer) (str/blank? line))
          (recur session)

          (and (str/blank? buffer) (command? line))
          (let [next-session (await (run-command session line))]
            (if next-session (recur next-session) session))

          :else
          (let [text (str buffer line "\n")]
            (if (form-complete? text)
              (do
                (reset! input-buffer "")
                (recur (await (eval-text session text))))
              (do
                (reset! input-buffer text)
                (recur session)))))))))

(defn- handle-interrupt
  "Ctrl-C stops a running form, or abandons the line being typed."
  [current evaluating? input-buffer interactive?]
  (if @evaluating?
    (.kill (:proc (:vm @current)) io/ProcessSignal.sigkill)
    (do
      (reset! input-buffer "")
      (when interactive?
        (write "\nuser=> ")))))

(defn repl-main []
  (let [interactive? (.-hasTerminal io/stdin)
        dir (.-path (.createTempSync io/Directory.systemTemp "cljd2dart-repl-"))
        evaluating? (atom false)
        input-buffer (atom "")
        session (atom {:dir dir
                       :vm (await (start-vm dir))
                       :state (t/repl-state)
                       :forms []
                       :evaluating? evaluating?})
        signals (.listen (.watch io/ProcessSignal.sigint)
                         (fn [_]
                           (handle-interrupt session evaluating? input-buffer
                                             interactive?)))
        lines (async/StreamIterator.
               (.transform (.transform io/stdin (.-decoder convert/utf8))
                           (convert/LineSplitter.)))]
    (when interactive? (writeln banner))
    (let [last-session (await (repl-loop @session lines interactive? input-buffer))]
      (when interactive? (writeln ""))
      (await (stop-vm (:vm last-session)))
      (await (.cancel signals))
      (.deleteSync (io/Directory. dir) .recursive true)
      (await (.flush io/stdout))
      (io/exit 0))))
