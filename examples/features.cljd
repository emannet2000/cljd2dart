(ns features.core
  (:require [cljd.string :as str]
            ["dart:math" :as math]))

(defn classify [n]
  (cond
    (< n 0) "negative"
    (= n 0) "zero"
    :else "positive"))

(defn sum [xs]
  (reduce + 0 xs))

(defn pair-sum [[a b]]
  (+ a b))

(defn main []
  (println (classify -3) (classify 0) (classify 7))
  (println (when true "yes") (when false "no"))
  (println (and 1 2 3) (or nil false 42))
  (println (sum [1 2 3 4]))
  (println (pair-sum [10 20]))
  (println (str/upper-case "hello") (str/join "-" ["a" "b"]))
  (println (get-in {:a {:b 2}} [:a :b]))
  (println (update {:n 1} :n inc))
  (println (into [] (range 3)))
  (println (sort [3 1 2]))
  (println (case 2 1 "one" 2 "two" "many"))
  (let [a (atom 0)]
    (swap! a inc)
    (swap! a + 10)
    (println "atom" @a))
  (println (quote (a b :c)))
  (println (= [1 2] [1 2]) (not= 1 2))
  (println (math/sqrt 16))
  (println (map #(* % %) [1 2 3]))
  (println (#(+ %1 %2) 4 5))
  (println (take-while #(< % 3) (range 6)))
  (println (concat [1 2] [3 4]))
  (println (some even? [1 3 4]) (every? pos? [1 2]))
  (doseq [x [1 2]
          y [:a :b]]
    (println x y)))
