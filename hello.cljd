(ns hello.core
  (:require ["dart:math" :as math]))

(def greeting "Hello")

(defn greet [name]
  (str greeting ", " name "!"))

(defn fact [n]
  (loop [i n
         acc 1]
    (if (<= i 1)
      acc
      (recur (dec i) (* acc i)))))

(defn main []
  (println (greet "ClojureDart"))
  (println "fact(5) =" (fact 5))
  (println "sqrt(81) =" (math/sqrt 81))
  (let [{:keys [name age] :or {age 0}} {:name "Ada" :age 36}
        [a b & more] [1 2 3 4]]
    (println name age a b more))
  (println (map (fn [x] (* x x)) [1 2 3 4]))
  (println (-> 5 inc (* 2)))
  (println (assoc {:a 1} :b 2))
  (println (filter even? (range 10)))
  (doseq [x [1 2 3]]
    (println "item" x)))
